From 9df161a2c6194df7f49e198b5b508b735065b157 Mon Sep 17 00:00:00 2001
From: Liam Fries <contributor@spacefox.invalid>
Date: Sun, 6 Sep 2026 11:21:46 -0400
Subject: [PATCH] Include spacefox-sets.inc.xhtml in browser.xhtml and
 macWindow.inc.xhtml

---
 browser/base/content/browser.xhtml       | 1 +
 browser/base/content/macWindow.inc.xhtml | 1 +
 2 files changed, 2 insertions(+)

diff --git a/browser/base/content/browser.xhtml b/browser/base/content/browser.xhtml
index ba0c75360c..beedfd57ae 100644
--- a/browser/base/content/browser.xhtml
+++ b/browser/base/content/browser.xhtml
@@ -118,6 +118,7 @@
 # *must* go into the browser-sets.inc.xhtml file so that they can be shared with
 # other top level windows in macWindow.inc.xhtml.
 #include browser-sets.inc.xhtml
+#include spacefox-sets.inc.xhtml
 
 #include main-popupset.inc.xhtml
 
diff --git a/browser/base/content/macWindow.inc.xhtml b/browser/base/content/macWindow.inc.xhtml
index bf9c45905a..d999d3fe88 100644
--- a/browser/base/content/macWindow.inc.xhtml
+++ b/browser/base/content/macWindow.inc.xhtml
@@ -31,6 +31,7 @@
 # *must* go into the browser-sets.inc.xhtml file so that they can be shared with
 # browser.xhtml
 #include browser-sets.inc.xhtml
+#include spacefox-sets.inc.xhtml
 
 # The entire main menubar is placed into browser-menubar.inc.xhtml, so that it
 # can be shared with browser.xhtml.
